<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root { --fg: #1a1a2e; --accent: #0066cc; --muted: #5c5c6e; --bg: #fafbfc; }
  body {
    font-family: "Segoe UI", system-ui, sans-serif;
    line-height: 1.65;
    max-width: 48rem;
    margin: 2rem auto;
    padding: 0 1.25rem 2rem;
    color: var(--fg);
    background: var(--bg);
  }
  header {
    border-bottom: 3px solid var(--accent);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
  }
  h1 { font-size: 1.75rem; margin: 0 0 0.35rem; }
  .subtitle { color: var(--muted); font-size: 0.95rem; margin: 0; }
  .content table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
  .content th, .content td { border: 1px solid #d0d7de; padding: 0.5rem 0.75rem; text-align: left; }
  .content th { background: #eef2f7; }
  footer { margin-top: 2rem; font-size: 0.85rem; color: var(--muted); border-top: 1px solid #e0e0e0; padding-top: 0.75rem; }
</style>
</head>
<body>
<article>
  <header>
    <h1>{{ title }}</h1>
    <p class="subtitle">Stakeholder brief — Canvas artifact</p>
  </header>
  <section class="content">{{ body_html }}</section>
  <footer>Generated from grounded tool payloads.</footer>
</article>
</body>
</html>
